VITE_USUARIOS_GET_BY_ID=/api/usuarios/getUsuarioById
VITE_USUARIOS_UPDATE=/api/usuarios/updateUsuario

# ========================================
# ENDPOINTS DE CATÁLOGOS
# ========================================
VITE_CATALOGOS_LOCALIDAD_POR_CP=/api/catalogo/localidadByCP
VITE_CATALOGOS_CAT_DOCUMENTOS=/api/catalogo/catDocumentos
VITE_CATALOGOS_CAT_USUARIOS=/api/catalogo/catUsuarios

# ========================================
# ENDPOINTS DE DOCUMENTOS
# ========================================
VITE_DOCUMENTOS_CREATE=/api/documentos/createDocumento
VITE_DOCUMENTOS_BY_USER=/api/documentos/documentosByUsuario
VITE_DOCUMENTOS_BY_SOLICITUD=/api/documentos/documentosBySolicitud
VITE_DOCUMENTOS_DOWNLOAD=/api/documentos/downloadDocumento
VITE_DOCUMENTOS_UPDATE=/api/documentos/updateDocumento

