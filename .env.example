# ──────────────────────────────────────────────────────────────
# VDID SDK – VeriDocID / Suma México
# Documentación: https://www.npmjs.com/package/vdid-sdk-web
# ──────────────────────────────────────────────────────────────

# Clave pública entregada por el equipo de Suma México.
# Sin esta clave el botón "Escanear con VDID" / "Prueba de Vida con VDID" no aparecerá.
VITE_VDID_PUBLIC_KEY=tu_clave_publica_aqui

# URL base del API de verificaciones de Suma México.
# Solo es necesaria para el flujo completo (documentos + prueba de vida).
# Ejemplo: https://api.veridocid.com/v2
# Si no la configuras, la app usará el flujo de sólo captura de imágenes (sin UUID).
VITE_VDID_API_URL=https://api.veridocid.com/v2

