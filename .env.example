# ========================================
# CONFIGURACIÓN DEL API BACKEND
# ========================================
# Copia este archivo como .env y configura los valores correctos
# NUNCA subas el archivo .env al repositorio

# URL base del servidor (sin barra al final)
VITE_API_URL=https://tu-dominio.com
# Ejemplo local: VITE_API_URL=http://localhost:3001

# ========================================
# ENDPOINTS DE AUTENTICACIÓN
# ========================================
VITE_AUTH_LOGIN=/auth/login

# ========================================
# ENDPOINTS DE USUARIOS
# ========================================
VITE_USUARIOS_CREATE=/api/usuarios/createUsuario
VITE_USUARIOS_GET_BY_ID=/api/usuarios/getUsuarioById
VITE_USUARIOS_UPDATE=/api/usuarios/updateUsuario

# ========================================
# ENDPOINTS DE CATÁLOGOS
# ========================================
VITE_CATALOGOS_LOCALIDAD_POR_CP=/api/catalogo/localidadByCP
VITE_CATALOGOS_CAT_DOCUMENTOS=/api/catalogo/catDocumentos
VITE_CATALOGOS_CAT_USUARIOS=/api/catalogo/catUsuarios

# ========================================
# ENDPOINTS DE DOCUMENTOS
# ========================================
VITE_DOCUMENTOS_CREATE=/api/documentos/createDocumento
VITE_DOCUMENTOS_BY_USER=/api/documentos/documentosByUsuario
VITE_DOCUMENTOS_BY_SOLICITUD=/api/documentos/documentosBySolicitud
VITE_DOCUMENTOS_DOWNLOAD=/api/documentos/downloadDocumento
VITE_DOCUMENTOS_UPDATE=/api/documentos/updateDocumento

# ========================================
# ENDPOINTS DE SOLICITUDES
# ========================================
VITE_SOLICITUDES_CREATE=/api/solicitudes/createSolicitud
VITE_SOLICITUDES_BY_USER=/api/solicitudes/solicitudesByIdUsuario
VITE_SOLICITUDES_GET_ALL=/api/solicitudes/solicitudes
VITE_SOLICITUDES_BY_ESTATUS=/api/solicitudes/solicitudesByIdEstatus
VITE_SOLICITUDES_UPDATE=/api/solicitudes/updateSolicitud

# ========================================
# ENDPOINTS DE REVISIONES
# ========================================
VITE_REVISION_CREATE=/api/revisiones/createRevision
VITE_REVISION_BY_SOLICITUD=/api/revisiones/revisionesBySolicitud
VITE_REVISION_BY_REVISOR=/api/revisiones/revisionesByRevisor
VITE_REVISION_CREATE_DOCUMENTOS=/createRevisionDocumentos
VITE_REVISION_UPDATE_DOCUMENTO=/updateRevisionDocumento
VITE_REVISION_DOCUMENTOS_BY_REVISION=/revisionesDocumentosByRevision
VITE_REVISION_DOCUMENTOS_BY_DOCUMENTO=/revisionesDocumentosByDocumento

# ========================================
# ENDPOINTS DE EXÁMENES
# ========================================
VITE_EXAM_OBTENER_PREGUNTAS=/api/pruebas/examen-teorico/obtener-preguntas
VITE_EXAM_ENVIAR_RESPUESTAS=/api/pruebas/examen-teorico/enviar-respuestas
VITE_EXAM_VERIFICAR_RESULTADO=/api/pruebas/examen-teorico/verificar-resultado
VITE_EXAM_VERIFICAR_APROBACION=/api/pruebas/examen-teorico/verificar-aprobacion
VITE_EXAM_OBTENER_POR_SOLICITUD=/api/pruebas/obtener-por-solicitud

# ========================================
# ENDPOINTS DE DASHBOARD
# ========================================
VITE_DASHBOARD_ADMIN_DATA=/api/dashboard/getDashboardTramite
VITE_DASHBOARD_OPERADORES_DATA=/api/dashboard/getDashboardRevisor

# ========================================
# ENDPOINTS DE FOTOS DE ROSTRO
# ========================================
VITE_FOTOS_ROSTRO_SUBIR=/api/fotos-rostro/subir
VITE_FOTOS_ROSTRO_DESCARGAR=/api/fotos-rostro/descargar
VITE_FOTOS_ROSTRO_TRANSITO=/api/fotos-rostro/transitoFoto
VITE_FOTOS_ROSTRO_URL=/api/fotos-rostro/url

# ========================================
# ENDPOINTS DE WALLET
# ========================================
VITE_WALLET_PKPASS=/api/wallet/pkpass
VITE_WALLET_GOOGLE_JWT=/wallet/google/create

# ========================================
# VDID SDK – VeriDocID / Suma México
# https://www.npmjs.com/package/vdid-sdk-web
# ========================================
# ⚠️ Solo la clave PÚBLICA va aquí.
# Las credenciales secretas (API_KEY, CLIENT_ID, CLIENT_SECRET) van ÚNICAMENTE en el .env del BACKEND.
VITE_VDID_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_VDID_CREATE_VERIFICATION=/api/vdid/createVerification
VITE_VDID_STATUS=/api/vdid/status
VITE_VDID_RESULTS=/api/vdid/results

# ========================================
# GEMINI AI (opcional)
# ========================================
VITE_GEMINI_API_KEY=tu_clave_de_gemini_aqui

# ========================================
# NOTAS IMPORTANTES
# ========================================
# - Todos los endpoints son relativos a VITE_API_URL
# - NUNCA pongas API_KEY, CLIENT_SECRET ni credenciales privadas aquí
# - Las credenciales de VDID van en el .env del BACKEND (sin prefijo VITE_)
# - Los cambios requieren reiniciar el servidor de desarrollo (npm run dev)
